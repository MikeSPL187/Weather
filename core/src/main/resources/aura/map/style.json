{
  "version": 8,
  "name": "Aura Night",
  "sources": {
    "base": { "type": "vector", "url": "https://tiles.openfreemap.org/planet" }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#101A3C" } },
    { "id": "landcover-farm", "type": "fill", "source": "base", "source-layer": "landcover",
      "filter": ["in", ["get", "class"], ["literal", ["farmland", "grass"]]],
      "paint": { "fill-color": "#122045", "fill-opacity": 0.7 } },
    { "id": "landcover-wood", "type": "fill", "source": "base", "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "wood"],
      "paint": { "fill-color": "#0F2A3A", "fill-opacity": ["interpolate", ["linear"], ["zoom"], 5, 0.6, 10, 0.9] } },
    { "id": "landuse-residential", "type": "fill", "source": "base", "source-layer": "landuse",
      "filter": ["in", ["get", "class"], ["literal", ["residential", "suburb", "neighbourhood", "commercial", "industrial", "retail"]]],
      "paint": { "fill-color": "#17234D", "fill-opacity": ["interpolate", ["linear"], ["zoom"], 6, 0.5, 12, 0.9] } },
    { "id": "park", "type": "fill", "source": "base", "source-layer": "park",
      "paint": { "fill-color": "#11303F", "fill-opacity": 0.8 } },
    { "id": "water", "type": "fill", "source": "base", "source-layer": "water",
      "paint": { "fill-color": "#0A2C57" } },
    { "id": "water-edge", "type": "line", "source": "base", "source-layer": "water",
      "paint": { "line-color": "#1E4F8C", "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.4, 12, 1.2], "line-opacity": 0.7 } },
    { "id": "waterway", "type": "line", "source": "base", "source-layer": "waterway",
      "filter": ["in", ["get", "class"], ["literal", ["river", "canal"]]],
      "paint": { "line-color": "#0F3768", "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 6, 0.6, 14, 6] } },
    { "id": "boundary-region", "type": "line", "source": "base", "source-layer": "boundary",
      "filter": ["all", ["==", ["get", "admin_level"], 4], ["!=", ["get", "maritime"], 1]],
      "paint": { "line-color": "#3A4C86", "line-width": 0.8, "line-dasharray": [3, 2], "line-opacity": 0.7 } },
    { "id": "boundary-country", "type": "line", "source": "base", "source-layer": "boundary",
      "filter": ["all", ["==", ["get", "admin_level"], 2], ["!=", ["get", "maritime"], 1]],
      "paint": { "line-color": "#6A7CC0", "line-width": ["interpolate", ["linear"], ["zoom"], 3, 0.8, 10, 2], "line-opacity": 0.8 } },
    { "id": "road-minor", "type": "line", "source": "base", "source-layer": "transportation", "minzoom": 10,
      "filter": ["in", ["get", "class"], ["literal", ["minor", "service", "tertiary"]]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#24346A", "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 10, 0.4, 16, 6] } },
    { "id": "road-major", "type": "line", "source": "base", "source-layer": "transportation", "minzoom": 6,
      "filter": ["in", ["get", "class"], ["literal", ["primary", "secondary", "trunk"]]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#33478A", "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 6, 0.5, 16, 10] } },
    { "id": "road-motorway", "type": "line", "source": "base", "source-layer": "transportation", "minzoom": 5,
      "filter": ["==", ["get", "class"], "motorway"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#4A5FA8", "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 5, 0.6, 16, 12] } },
    { "id": "rail", "type": "line", "source": "base", "source-layer": "transportation", "minzoom": 9,
      "filter": ["==", ["get", "class"], "rail"],
      "paint": { "line-color": "#2E3E78", "line-width": 1, "line-dasharray": [2, 2] } },
    { "id": "buildings-3d", "type": "fill-extrusion", "source": "base", "source-layer": "building", "minzoom": 13,
      "paint": {
        "fill-extrusion-color": ["interpolate", ["linear"], ["coalesce", ["get", "render_height"], 10], 0, "#1C2A5C", 60, "#2C3F80", 200, "#3E56A6"],
        "fill-extrusion-height": ["interpolate", ["linear"], ["zoom"], 13, 0, 14, ["coalesce", ["get", "render_height"], 8]],
        "fill-extrusion-base": ["coalesce", ["get", "render_min_height"], 0],
        "fill-extrusion-opacity": 0.85
      } },
    { "id": "road-label", "type": "symbol", "source": "base", "source-layer": "transportation_name", "minzoom": 12,
      "layout": { "symbol-placement": "line", "text-field": ["coalesce", ["get", "name:ru"], ["get", "name"]], "text-font": ["Noto Sans Regular"], "text-size": 11 },
      "paint": { "text-color": "#8C9BD0", "text-halo-color": "#101A3C", "text-halo-width": 1.4 } },
    { "id": "water-label", "type": "symbol", "source": "base", "source-layer": "water_name", "minzoom": 7,
      "layout": { "text-field": ["coalesce", ["get", "name:ru"], ["get", "name"]], "text-font": ["Noto Sans Regular"], "text-size": 12, "text-letter-spacing": 0.08 },
      "paint": { "text-color": "#5F8FD0", "text-halo-color": "#0A2C57", "text-halo-width": 1 } },
    { "id": "place-village", "type": "symbol", "source": "base", "source-layer": "place", "minzoom": 9,
      "filter": ["in", ["get", "class"], ["literal", ["village", "suburb", "hamlet"]]],
      "layout": { "text-field": ["coalesce", ["get", "name:ru"], ["get", "name"]], "text-font": ["Noto Sans Regular"], "text-size": ["interpolate", ["linear"], ["zoom"], 9, 10, 14, 13] },
      "paint": { "text-color": "#A9B5E0", "text-halo-color": "#101A3C", "text-halo-width": 1.4 } },
    { "id": "place-town", "type": "symbol", "source": "base", "source-layer": "place", "minzoom": 6,
      "filter": ["==", ["get", "class"], "town"],
      "layout": { "text-field": ["coalesce", ["get", "name:ru"], ["get", "name"]], "text-font": ["Noto Sans Regular"], "text-size": ["interpolate", ["linear"], ["zoom"], 6, 11, 12, 15] },
      "paint": { "text-color": "#D3DBF5", "text-halo-color": "#101A3C", "text-halo-width": 1.6 } },
    { "id": "place-city", "type": "symbol", "source": "base", "source-layer": "place",
      "filter": ["==", ["get", "class"], "city"],
      "layout": { "text-field": ["coalesce", ["get", "name:ru"], ["get", "name"]], "text-font": ["Noto Sans Bold"], "text-size": ["interpolate", ["linear"], ["zoom"], 4, 12, 10, 18], "text-transform": "none" },
      "paint": { "text-color": "#FFFFFF", "text-halo-color": "#101A3C", "text-halo-width": 1.8 } },
    { "id": "place-country", "type": "symbol", "source": "base", "source-layer": "place", "maxzoom": 7,
      "filter": ["==", ["get", "class"], "country"],
      "layout": { "text-field": ["coalesce", ["get", "name:ru"], ["get", "name"]], "text-font": ["Noto Sans Bold"], "text-size": 13, "text-letter-spacing": 0.2, "text-transform": "uppercase" },
      "paint": { "text-color": "#7F8EC8", "text-halo-color": "#101A3C", "text-halo-width": 1.4 } }
  ]
}
